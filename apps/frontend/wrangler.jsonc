{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "englishcode-frontend-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true }
  },
  "services": [
    {
      "binding": "BACKEND",
      "service": "englishcode-backend-dev"
    }
  ]
}
