{
  "name": "@englishcode/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply englishcode-local --local",
    "db:seed:local": "wrangler d1 execute englishcode-local --local --file=../../database/seeds/0001_demo.sql",
    "db:migrate:dev": "wrangler d1 migrations apply englishcodeapp-dev --remote",
    "db:seed:dev": "wrangler d1 execute englishcodeapp-dev --remote --file=../../database/seeds/0001_demo.sql",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy:dev": "wrangler deploy",
    "test:d1-local": "python3 ../../scripts/verify_backend_d1_local.py"
  },
  "dependencies": {
    "hono": "^4.8.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261125.1",
    "typescript": "^5.8.3",
    "vitest": "4.1.12",
    "wrangler": "^4.45.0",
    "vite": "7.3.8"
  }
}
