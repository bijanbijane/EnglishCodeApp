{
  "name": "@englishcode/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply englishcodeapp-dev --local",
    "db:seed:local": "wrangler d1 execute englishcodeapp-dev --local --file=../../database/seeds/0001_demo.sql",
    "db:migrate:dev": "wrangler d1 migrations apply englishcodeapp-dev --remote",
    "db:seed:dev": "wrangler d1 execute englishcodeapp-dev --remote --file=../../database/seeds/0001_demo.sql",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy:dev": "wrangler deploy",
    "test:d1-local": "python3 ../../scripts/verify_backend_d1_local.py",
    "db:seed:a1:local": "wrangler d1 execute englishcodeapp-dev --local --file=../../database/seeds/0002_a1_foundations.sql",
    "db:seed:a1:dev": "wrangler d1 execute englishcodeapp-dev --remote --file=../../database/seeds/0002_a1_foundations.sql",
    "db:seed:a1:unit-02:local": "wrangler d1 execute englishcodeapp-dev --local --file=../../database/seeds/0003_a1_unit_02.sql",
    "db:seed:a1:unit-02:dev": "wrangler d1 execute englishcodeapp-dev --remote --file=../../database/seeds/0003_a1_unit_02.sql",
    "db:seed:a1:unit-03:local": "wrangler d1 execute englishcodeapp-dev --local --file=../../database/seeds/0004_a1_unit_03.sql",
    "db:seed:a1:unit-03:dev": "wrangler d1 execute englishcodeapp-dev --remote --file=../../database/seeds/0004_a1_unit_03.sql",
    "db:seed:a1:unit-04:local": "wrangler d1 execute englishcodeapp-dev --local --file=../../database/seeds/0005_a1_unit_04.sql",
    "db:seed:a1:unit-04:dev": "wrangler d1 execute englishcodeapp-dev --remote --file=../../database/seeds/0005_a1_unit_04.sql",
    "db:seed:a1:unit-05:local": "wrangler d1 execute englishcodeapp-dev --local --file=../../database/seeds/0006_a1_unit_05.sql",
    "db:seed:a1:unit-05:dev": "wrangler d1 execute englishcodeapp-dev --remote --file=../../database/seeds/0006_a1_unit_05.sql",
    "db:seed:a1:unit-06:local": "wrangler d1 execute englishcodeapp-dev --local --file=../../database/seeds/0007_a1_unit_06.sql",
    "db:seed:a1:unit-06:dev": "wrangler d1 execute englishcodeapp-dev --remote --file=../../database/seeds/0007_a1_unit_06.sql",
    "db:seed:a1:unit-07:local": "wrangler d1 execute englishcodeapp-dev --local --file=../../database/seeds/0008_a1_unit_07.sql",
    "db:seed:a1:unit-07:dev": "wrangler d1 execute englishcodeapp-dev --remote --file=../../database/seeds/0008_a1_unit_07.sql",
    "db:seed:a1:unit-08:local": "wrangler d1 execute englishcodeapp-dev --local --file=../../database/seeds/0009_a1_unit_08.sql",
    "db:seed:a1:unit-08:dev": "wrangler d1 execute englishcodeapp-dev --remote --file=../../database/seeds/0009_a1_unit_08.sql",
    "db:seed:a1:unit-09:local": "wrangler d1 execute englishcodeapp-dev --local --file=../../database/seeds/0010_a1_unit_09.sql",
    "db:seed:a1:unit-09:dev": "wrangler d1 execute englishcodeapp-dev --remote --file=../../database/seeds/0010_a1_unit_09.sql"
  },
  "dependencies": {
    "hono": "^4.8.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261125.1",
    "typescript": "^5.8.3",
    "vitest": "4.1.12",
    "wrangler": "^4.45.0",
    "vite": "7.3.8"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.2 <11"
  }
